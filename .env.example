# ---- Backend ----
PORT=5000
JWT_SECRET=change-me-in-production
DB_PATH=./data/app.db

# ---- OTP ----
# When true, OTP codes are returned in API responses & printed to console
OTP_DEMO_MODE=true

# ---- AI (optional) ----
# Leave empty to use the built-in deterministic demo AI engine
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Frontend ----
VITE_API_URL=http://localhost:5000/api
